{
  "name": "dynamic-island-pro",
  "version": "2.6.1",
  "description": "An interactive, ultra-smooth Dynamic Island for Windows desktop with live activities, smart tools & widgets",
  "main": "out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:e2e",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "pack": "npm run build && electron-builder --win --dir --publish never",
    "build:promo": "npm run build && tsx scripts/build-promo.ts",
    "build:supporter": "tsx scripts/build-supporter.ts",
    "media:supporter": "npm run build:promo && npm run build:supporter && tsx scripts/supporter/media.ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" playwright.config.ts",
    "test:promo": "npm run build:promo && tsx scripts/test-promo.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "profile:performance": "npm run build && tsx scripts/profile-performance.ts"
  },
  "author": {
    "name": "Belal Yosry",
    "url": "https://github.com/beloyosry",
    "phone": "+201153969065"
  },
  "homepage": "https://github.com/beloyosry/Desktop-Dynamic-Island",
  "repository": {
    "type": "git",
    "url": "https://github.com/beloyosry/Desktop-Dynamic-Island.git"
  },
  "bugs": {
    "url": "https://github.com/beloyosry/Desktop-Dynamic-Island/issues"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.dynamicislandpro.app",
    "productName": "Dynamic Island Pro",
    "copyright": "Copyright © 2026 Belal Yosry. All rights reserved.",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/icon.ico",
      "helper/nova-helper.exe",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!out/promo/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "beloyosry",
      "repo": "Desktop-Dynamic-Island"
    },
    "asarUnpack": [
      "helper/nova-helper.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Dynamic Island Pro"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Dynamic-Island-Pro-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Dynamic Island Pro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Dynamic Island Pro ${version} portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  }
}
